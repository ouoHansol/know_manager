# 이 파일을 .env 로 복사해서 실제 값만 채우세요.
# .env 는 .gitignore 처리되어 커밋되지 않습니다.

KNOU_ID=
KNOU_PASSWORD=

# 기본은 브라우저를 띄우지 않고 실행합니다. 로그인 실패 시 true 로 바꿔 화면을 보면서 확인하세요.
KNOU_HEADLESS=true

# 자동 수집 대상 URL입니다. 학교 메뉴 URL이 바뀌면 여기에 추가/수정하세요.
KNOU_START_URL=https://www.knou.ac.kr/index.jsp
KNOU_UCAMPUS_URL=https://ucampus.knou.ac.kr/ekp/user/main/retrieveUIXMain.do

# 로그인 후 직접 열어볼 후보 URL. 쉼표로 여러 개 입력 가능.
# 과제물 제출상태, 출석수업, 출석대체 신청, 성적/학점 화면 URL을 추가하면
# 미제출/기간초과/평가완료/학점 문구를 자동 분류합니다.
KNOU_EXTRA_URLS=
